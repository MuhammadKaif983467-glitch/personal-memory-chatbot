# =====================================================================
# Personal Memory Chatbot - environment configuration
# Copy to .env and fill in real values. Never commit .env to git.
# Only OPENROUTER_API_KEY is truly required for live AI answers.
# =====================================================================

# ---------- Core ----------
LOG_LEVEL=INFO
SHOW_MEMORY_SOURCES=true
CONSENT_REQUIRED=true
ANALYZE_ON_IMPORT=true
APP_VERSION=1.0.0

# ---------- Storage ----------
# Leave empty to use defaults under ./data
DATABASE_URL=
VECTOR_DB_PATH=

# Vector store backend: auto | chroma | simple
#   chroma  -> persistent ChromaDB collection (requires pip install chromadb)
#   simple  -> local SQLite + numpy cosine similarity (zero extra deps)
#   auto    -> chroma if installed, otherwise simple
VECTOR_STORE=auto

# ---------- AI provider ----------
# Provider: auto | openrouter | openai | mock | local
#   openrouter -> OpenRouter API (chat + embeddings) - the active default
#   openai     -> native OpenAI API (optional fallback)
#   local      -> offline heuristic provider so the app is usable without a key
#   mock       -> deterministic fake provider (used in tests)
#   auto       -> openrouter if OPENROUTER_API_KEY is set, else openai if
#                 OPENAI_API_KEY is set, otherwise local
AI_PROVIDER=openrouter

# ---------- OpenRouter ----------
# Put your real keys ONLY in your local .env. Never commit them.
#
# Key separation (recommended):
#   OPENROUTER_API_KEY_1 -> embedding calls only
#   OPENROUTER_API_KEY_2 -> chat calls only
# The legacy OPENROUTER_API_KEY below is an optional fallback for both when a
# dedicated key is unset; it is NOT required when KEY_1 and KEY_2 are set.
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Ordered model list (comma/space/newline separated). The provider tries every
# model and falls back to the next one when the current model is not accessible
# on the account or returns an unusable embedding dimension.
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
# Extra models appended after OPENROUTER_CHAT_MODEL (optional).
# OPENROUTER_CHAT_MODELS=
# Embedding model (OpenRouter returns OpenAI-compatible vectors).
# Every listed embedding model must output OPENROUTER_EMBEDDING_DIMENSIONS-dim
# vectors; otherwise the provider treats it as unusable and falls back.
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# Extra embedding models appended after OPENROUTER_EMBEDDING_MODEL (optional).
# OPENROUTER_EMBEDDING_MODELS=
# text-embedding-3-small outputs 1536-dimension vectors by default.
OPENROUTER_EMBEDDING_DIMENSIONS=1536

# ---------- Voice (Phase V) ----------
# Voice is optional and off by default. OPENROUTER_TTS_MODEL is a config-only
# descriptor surfaced by the voice capability layer; no live audio synthesis is
# sent by the core product, so it never requires or exposes a credential.
VOICE_ENABLED=false
VOICE_STT_PROVIDER=auto
VOICE_TTS_PROVIDER=auto
VOICE_STT_API_KEY=
VOICE_TTS_API_KEY=
OPENROUTER_TTS_MODEL=deepgram/flux-tts:free

# ---------- OpenAI (optional, for provider switching) ----------
# Only used when AI_PROVIDER=openai. Placeholder value - never a real key.
OPENAI_API_KEY=your_api_key_here
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ---------- Retrieval / context / confidence ----------
MEMORY_MIN_CONFIDENCE=0.5
RETRIEVAL_LIMIT=12
CONTEXT_BUDGET_CHARS=9000
RECENT_CONVERSATION_MESSAGES=10

# ---------- CORS (comma separated) ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173